{
  "name": "katebrune.net",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @katebrune/web dev",
    "build": "pnpm --filter @katebrune/web build",
    "start": "pnpm --filter @katebrune/web start",
    "lint": "pnpm --filter @katebrune/web lint",
    "test": "pnpm --filter @katebrune/web test",
    "storybook": "pnpm --filter @katebrune/web storybook",
    "build-storybook": "pnpm --filter @katebrune/web build-storybook",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,yml,yaml}": "prettier --write"
  }
}
